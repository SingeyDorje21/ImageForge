DATABASE_URL=postgresql+asyncpg://imageforge:imageforge@localhost:5433/imageforge
S3_BUCKET=imageforge
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=imageforge
S3_SECRET_ACCESS_KEY=imageforge-secret
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
S3_URL_EXPIRY_SECONDS=3600
MAX_FILE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=10
QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=image_jobs
RETRY_QUEUE_NAME=image_jobs_retry
DLQ_NAME=image_jobs_dlq
MAX_RETRIES=3
REDIS_URL=redis://localhost:6379/0
ADMIN_PASSWORD=imageforge_admin_123
CORS_ORIGINS=http://localhost:5173
# Only for QUEUE_BACKEND=cloudtasks (see deploy/cloudrun/README.md)
GCP_PROJECT=
GCP_LOCATION=us-central1
CLOUD_TASKS_QUEUE=image-jobs
WORKER_URL=http://localhost:8080
TASKS_SERVICE_ACCOUNT=
