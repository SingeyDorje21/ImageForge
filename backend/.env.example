DATABASE_URL=postgresql+asyncpg://imageforge:imageforge@localhost:5433/imageforge
S3_BUCKET=imageforge
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=imageforge
S3_SECRET_ACCESS_KEY=imageforge-secret
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
S3_URL_EXPIRY_SECONDS=3600
MAX_FILE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=10
QUEUE_BACKEND=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=image_jobs
RETRY_QUEUE_NAME=image_jobs_retry
DLQ_NAME=image_jobs_dlq
MAX_RETRIES=3
REDIS_URL=redis://localhost:6379/0
# Admin login is disabled until this is set. Use a strong password.
ADMIN_PASSWORD=
# Secret for signing admin tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_TTL_MINUTES=60
# Failed logins allowed per IP within the window before /login is blocked.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Set to true on Cloud Run or behind another proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Only for QUEUE_BACKEND=cloudtasks (see deploy/cloudrun/README.md)
GCP_PROJECT=
GCP_LOCATION=us-central1
CLOUD_TASKS_QUEUE=image-jobs
WORKER_URL=http://localhost:8080
TASKS_SERVICE_ACCOUNT=
# Neon: paste the connection string as given. A "-pooler" host (PgBouncer) is detected
# automatically and prepared-statement caching is turned off; set DATABASE_POOLED=true or
# false to override the detection.
# DATABASE_POOLED=
