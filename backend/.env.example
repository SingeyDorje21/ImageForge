DATABASE_URL=postgresql+asyncpg://imageforge:imageforge@localhost:5433/imageforge
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=image_jobs
RETRY_QUEUE_NAME=image_jobs_retry
DLQ_NAME=image_jobs_dlq
MAX_RETRIES=3
REDIS_URL=redis://localhost:6379/0
# Admin login is disabled until this is set. Use a strong password.
ADMIN_PASSWORD=
# Secret for signing admin tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_TTL_MINUTES=60
# Failed logins allowed per IP within the window before /login is blocked.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
