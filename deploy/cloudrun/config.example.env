# Copy to deploy/cloudrun/config.env (git-ignored) and fill in.
# Paste values exactly as given; no quotes needed, and characters like & or $ are fine.
# Values here end up in Secret Manager; nothing secret is stored in the services' plain env.

GCP_PROJECT=my-gcp-project
GCP_REGION=us-central1

# Neon (https://neon.tech): paste the connection string exactly as Neon shows it. The
# pooled one (host contains "-pooler") is recommended for Cloud Run.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Upstash Redis (https://upstash.com): the rediss:// URL from the console.
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# Cloudflare R2: create a bucket and an R2 API token with Object Read & Write.
S3_BUCKET=imageforge
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Admin login (from the admin-auth change). Generate JWT_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=
JWT_SECRET=

# The Vercel URL of the frontend (comma-separate several, e.g. a custom domain too)
CORS_ORIGINS=https://imageforge.vercel.app
